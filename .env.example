## Copy this file to `.env` (or paste these keys into your hosting provider's
## environment-variable settings) before building/running the project.
## Never commit the real `.env` — it's gitignored on purpose.

# WooCommerce REST API (live WordPress backend)
NUXT_PUBLIC_WC_API_URL=
NUXT_PUBLIC_WC_CONSUMER_KEY=
NUXT_PUBLIC_WC_CONSUMER_SECRET=

# Bulk import endpoint (custom/v1/import-products, custom/v1/import-fitment)
NUXT_PUBLIC_IMPORT_SECRET=

# Admin panel login (checked server-side in server/api/admin-login.js —
# NOT prefixed with NUXT_PUBLIC_, so it never ships in the client bundle)
ADMIN_USERNAME=
ADMIN_PASSWORD=
